{
  "manifest_version": 3,
  "name": "FlightCheck Voice Toggle",
  "version": "1.2",
  "description": "Global hotkey to toggle FlightCheck voice checklist mode. Change the shortcut at chrome://extensions/shortcuts",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "*://*.flightcheck.thefrog7272.workers.dev/*",
    "*://flightcheck.thefrog7272.workers.dev/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-voice": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Toggle FlightCheck voice checklist",
      "global": true
    }
  }
}
